      "signature": "async def run(self, spec: AgentRunSpec) -> AgentRunResult",
      "summary": "复制初始消息、创建 ContextGovernor 并进入核心循环。",
      "sourcePreview": [
        "async def run(self, spec: AgentRunSpec) -> AgentRunResult:",
        "    messages = deepcopy(spec.initial_messages)",
        "    governor = ContextGovernor(",
        "        self.provider, spec.context_config or self.context_config",
        "    )",
        "    return await self._run_core(spec, messages, governor)"
      ]
    },
