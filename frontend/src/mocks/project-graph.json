    {
      "id": "method:workspace:Workspace:resolve_path",
      "kind": "method",
      "label": "resolve_path",
      "parentId": "class:workspace:Workspace",
      "filePath": "mini_harness/workspace.py",
      "startLine": 51,
      "endLine": 73,
      "signature": "def resolve_path(self, value: str | Path) -> Path",
      "summary": "将相对路径解析到 Workspace 内，并拒绝越界路径。",
      "sourcePreview": [
        "def resolve_path(self, value: str | Path) -> Path:",
        "    raw = Path(value).expanduser()",
        "    candidate = raw.resolve() if raw.is_absolute() else (self.path / raw).resolve()",
        "    try:",
        "        candidate.relative_to(self.path)",
        "    except ValueError as exc:",
        "        raise WorkspacePathError(...) from exc",
        "    return candidate"
      ]
    },
